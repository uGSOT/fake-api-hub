# Copy this file to .env and fill in your MySQL credentials
# cp .env.example .env

APP_NAME=Fake API Hub
APP_ENV=development
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# MySQL — update with your local credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=fake_api_hub

# Optional: full URL overrides individual DB_* vars when set
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/fake_api_hub

# CORS — comma-separated origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
